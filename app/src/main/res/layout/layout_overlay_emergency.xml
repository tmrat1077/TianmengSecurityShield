<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07101F"
    android:clickable="true"
    android:fitsSystemWindows="false"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/emergency_title"
            android:src="@drawable/ic_virus" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.02"
            android:text="@string/emergency_title"
            android:textColor="@color/white"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOverlayKilled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/emergency_killed"
            android:textColor="#FFC107"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvOverlayCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/emergency_countdown"
            android:textColor="#A5D6A7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnOverlayYes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_danger_button"
            android:gravity="center"
            android:text="@string/emergency_yes"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnOverlayNo"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_gray_button"
            android:gravity="center"
            android:text="@string/emergency_no"
            android:textColor="#E0E0E0"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
